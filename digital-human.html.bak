        .av-card h3 { margin-bottom: 15px; color: #1a1a2e; font-size: 1.2em; }
        .av-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }
        @media (max-width: 768px) {
            .av-grid { grid-template-columns: 1fr; }
        }
        .tool-card {
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            padding: 20px;
            transition: all 0.3s;
        }
        .tool-card:hover {
            border-color: #00d4ff;
            box-shadow: 0 4px 20px rgba(0,212,255,0.15);
        }
        .tool-card h4 { color: #1a1a2e; margin-bottom: 8px; }
        .tool-card p { color: #666; font-size: 0.9em; margin-bottom: 12px; }
        .tool-card .tag {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.75em;
            margin-right: 5px;
            margin-bottom: 5px;
        }
        .tag-free { background: #c6f6d5; color: #22543d; }
        .tag-hot { background: #fed7d7; color: #9b2c2c; }
        .tag-new { background: #bee3f8; color: #2a4365; }
        .btn-launch {
            display: inline-block;
            padding: 8px 20px;
            background: linear-gradient(135deg, #00d4ff, #0099cc);
            color: white;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s;
        }
        .btn-launch:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,212,255,0.3); }
        .step-box {
            background: #f7fafc;
            border-left: 4px solid #00d4ff;
            padding: 15px;
            margin: 10px 0;
            border-radius: 0 8px 8px 0;
        }
        .step-box .step-num {
            display: inline-block;
            background: #00d4ff;
            color: white;
            width: 24px;
            height: 24px;
            text-align: center;
            line-height: 24px;
            border-radius: 50%;
            font-size: 0.8em;
            font-weight: bold;
            margin-right: 10px;
        }
        .preview-area {
            border: 2px dashed #cbd5e0;
            border-radius: 10px;
            padding: 40px;
            text-align: center;
            background: #f7fafc;
            min-height: 200px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
